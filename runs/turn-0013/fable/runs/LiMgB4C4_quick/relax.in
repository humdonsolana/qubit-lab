&control
  calculation = 'vc-relax'
  prefix = 'lab'
  outdir = './tmp'
  pseudo_dir = '/opt/pseudo/sssp'
  tprnfor = .true.
  tstress = .true.
  nstep = 150
  forc_conv_thr = 1.0d-4
  etot_conv_thr = 1.0d-6
/
&system
  ibrav = 0
  nat = 10
  ntyp = 4
  ecutwfc = 45
  ecutrho = 360
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&electrons
  conv_thr = 1.0d-11
  mixing_beta = 0.4
/
&ions
  ion_dynamics = 'bfgs'
/
&cell
  cell_dynamics = 'bfgs'
  press = 0
  press_conv_thr = 0.5
  cell_dofree = 'all'
/
